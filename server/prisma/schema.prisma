generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  code        String?
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]
  users       User[]
}

enum UserRole {
  ADMIN
  REGISTRY_OFFICER
  DEPARTMENT_OFFICER
  MANAGER
}

model User {
  id               Int                @id @default(autoincrement()) // Fixed to Int to match your active codebase
  name             String
  email            String             @unique
  password         String
  role             UserRole
  departmentId     Int?               // Fixed to Int? to align with Department.id
  department       Department?        @relation(fields: [departmentId], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt // Removed duplicate blocks below this
  auditLogs        AuditLog[]         @relation("AuditUser")
  createdDocuments Document[]         @relation("DocumentCreator")
  transfers        DocumentTransfer[] @relation("TransferUser")
}

model Document {
  id                  Int                @id @default(autoincrement())
  trackingNumber      String             @unique
  title               String
  description         String?
  priority            Priority           @default(NORMAL)
  status              DocumentStatus     @default(REGISTERED)
  // FK scalar — renamed from legacy "departmentId" to clarify document's current location
  currentDepartmentId Int
  createdById         Int
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  auditLogs           AuditLog[]
  createdBy           User               @relation("DocumentCreator", fields: [createdById], references: [id])
  // Relation field must use a distinct name from the FK scalar (was duplicate "currentDepartmentId")
  currentDepartment   Department         @relation(fields: [currentDepartmentId], references: [id])
  transfers           DocumentTransfer[]
}

model DocumentTransfer {
  id              Int      @id @default(autoincrement())
  documentId      Int
  fromDepartment  String
  toDepartment    String
  transferredById Int
  remarks         String?
  createdAt       DateTime @default(now())
  document        Document @relation(fields: [documentId], references: [id])
  transferredBy   User     @relation("TransferUser", fields: [transferredById], references: [id])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  documentId Int
  userId     Int
  action     String
  details    String?
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id])
  user       User     @relation("AuditUser", fields: [userId], references: [id])
}

enum DocumentStatus {
  REGISTERED
  RECEIVED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}