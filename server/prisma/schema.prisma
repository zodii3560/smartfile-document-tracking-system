generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  code        String?
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]
  users       User[]
  documentSequences DocumentSequence[]
  transfersFrom DocumentTransfer[] @relation("FromDepartment")
  transfersTo   DocumentTransfer[] @relation("ToDepartment")
}

enum UserRole {
  ADMIN
  REGISTRY_OFFICER
  DEPARTMENT_OFFICER
  MANAGER
}

model User {
  id               Int                @id @default(autoincrement()) // Fixed to Int to match your active codebase
  name             String
  email            String             @unique
  password         String
  role             UserRole
  isActive         Boolean  @default(true)
  departmentId     Int?               // Fixed to Int? to align with Department.id
  department       Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt // Removed duplicate blocks below this
  auditLogs        AuditLog[]         @relation("AuditUser")
  createdDocuments Document[]         @relation("DocumentCreator")
  transfers        DocumentTransfer[] @relation("TransferUser")
}

model Document {
  id                  Int                @id @default(autoincrement())
  trackingNumber      String             @unique
  title               String
  description         String?
  priority            Priority           @default(NORMAL)
  status              DocumentStatus     @default(REGISTERED)
  // FK scalar — renamed from legacy "departmentId" to clarify document's current location
  currentDepartmentId Int
  createdById         Int
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  auditLogs           AuditLog[]
  createdBy           User               @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  // Relation field must use a distinct name from the FK scalar (was duplicate "currentDepartmentId")
  currentDepartment   Department         @relation(fields: [currentDepartmentId], references: [id], onDelete: Restrict)
  transfers           DocumentTransfer[]

  @@index([trackingNumber])
  @@index([status])
  @@index([currentDepartmentId])
}

model DocumentTransfer {
  id                Int      @id @default(autoincrement())
  documentId        Int
  fromDepartmentId  Int
  toDepartmentId    Int
  transferredById   Int
  remarks           String?
  createdAt         DateTime @default(now())
  document          Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fromDepartment    Department @relation("FromDepartment", fields: [fromDepartmentId], references: [id], onDelete: Cascade)
  toDepartment      Department @relation("ToDepartment", fields: [toDepartmentId], references: [id], onDelete: Cascade)
  transferredBy     User       @relation("TransferUser", fields: [transferredById], references: [id], onDelete: Cascade)
}
model DocumentSequence {
  id           Int        @id @default(autoincrement())
  departmentId Int
  year         Int
  lastValue    Int        @default(0)

  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([departmentId, year])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  documentId Int
  userId     Int
  action     String
  details    String?
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation("AuditUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([createdAt])
}

enum DocumentStatus {
  REGISTERED
  RECEIVED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}