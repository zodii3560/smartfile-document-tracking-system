// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLERK
  OFFICER
  MANAGEMENT
}

enum DocumentStatus {
  REGISTERED
  RECEIVED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?

  users       User[]
  documents   Document[]

  createdAt   DateTime @default(now())
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String
  role          Role

  departmentId  Int?
  department    Department? @relation(fields: [departmentId], references: [id])

createdDocuments Document[]         @relation("DocumentCreator")
transfers        DocumentTransfer[] @relation("TransferUser")
auditLogs        AuditLog[]         @relation("AuditUser")

  createdAt     DateTime @default(now())
}

model Document {
  id                Int      @id @default(autoincrement())
  referenceNumber   String   @unique
  title             String
  description       String?

  priority          Priority @default(NORMAL)
  status            DocumentStatus @default(REGISTERED)

  departmentId      Int
  department        Department @relation(fields: [departmentId], references: [id])

  createdById       Int
  createdBy         User @relation("DocumentCreator", fields: [createdById], references: [id])

  transfers         DocumentTransfer[]
  auditLogs         AuditLog[]

  createdAt         DateTime @default(now())
}

model DocumentTransfer {
  id                Int @id @default(autoincrement())

  documentId        Int
  document          Document @relation(fields: [documentId], references: [id])

  fromDepartment    String
  toDepartment      String

  transferredById   Int
  transferredBy     User @relation("TransferUser", fields: [transferredById], references: [id])

  remarks           String?

  createdAt         DateTime @default(now())
}

model AuditLog {
  id            Int @id @default(autoincrement())

  documentId    Int
  document      Document @relation(fields: [documentId], references: [id])

  userId        Int
  user          User @relation("AuditUser", fields: [userId], references: [id])

  action        String
  details       String?

  createdAt     DateTime @default(now())
}